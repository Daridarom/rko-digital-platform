        {
          "text": "https://konzeptual.ru/aleksandr-nevskij-i-ego-jepoha-..",
          "href": "https://vk.com/away.php?to=https%3A%2F%2Fkonzeptual.ru%2Faleksandr-nevskij-i-ego-jepoha-12183%2F&post=-77957551_6994&cc_key="
